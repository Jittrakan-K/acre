{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.bat",
      "**/*.cmd",
      "**/*.exe",
      "**/*.zip",
      "**/*.backup",
      "index.before-redesign.html",
      "_UPLOAD-TO-GITHUB/**",
      "README.md",
      "acre-private-data.json",
      "job_requests_db.*",
      "ACHIEVEMENT-RECORD-WEB.zip",
      "firestore.rules"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}